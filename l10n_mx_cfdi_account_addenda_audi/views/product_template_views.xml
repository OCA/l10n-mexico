<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_product_template_form_inherit_addenda_audi" model="ir.ui.view">
        <field name="name">product.template.form.inherit.addenda.audi</field>
        <field name="model">product.template</field>
        <field
            name="inherit_id"
            ref="l10n_mx_cfdi.product_template_form_view_inherit"
        />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='CFDI']/group" position="inside">
                <field name="audi_ref" string="Audi Product Reference" />
            </xpath>
        </field>
    </record>
</odoo>
