<odoo>
    <record id="view_cfdi_transporter_form" model="ir.ui.view">
        <field name="name">Operador de Transporte</field>
        <field name="model">l10n_mx_cfdi_waybill.transporter</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="partner_id" />
                        <field name="type" />
                        <field name="driving_license" readonly="0" />
                        <field name="parte_transporte_ids" widget="many2many_tags" />
                        <field name="company_id" groups="base.group_system" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_cfdi_transporter_list" model="ir.ui.view">
        <field name="name">Operadores de Transporte</field>
        <field name="model">l10n_mx_cfdi_waybill.transporter</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id" />
                <field name="type" />
                <field name="driving_license" />
                <field name="parte_transporte_ids" widget="many2many_tags" />
            </list>
        </field>
    </record>

    <record id="action_mx_cfdi_transporter" model="ir.actions.act_window">
        <field name="name">Contactos</field>
        <field name="res_model">l10n_mx_cfdi_waybill.transporter</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_cfdi_transporter"
        name="Contactos"
        parent="stock_transfer_cfdi_root_menu"
        groups="base.group_user"
        action="action_mx_cfdi_transporter"
    />
</odoo>
