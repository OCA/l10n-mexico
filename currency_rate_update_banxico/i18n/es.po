#. module: currency_rate_update_banxico
#: model_terms:ir.ui.view,arch_db:currency_rate_update_banxico.res_currency_rate_provider_view_form
msgid ""
"<strong>!</strong>\n"
"                    You are using Bank of Mexico exchange rate\n"
"                    service with a base currency different from MXN.\n"
"                    <br/>\n"
"                    As long as the Bank of Mexico only provides\n"
"                    exchange rates based on MXN, other foreign currency\n"
"                    rates are recalculated and might differ from real rates."
msgstr ""
"<strong>!</strong>\n"
"                    Está utilizando el servicio de tipo de cambio del Banco\n"
"                    de México con una moneda base distinta del MXN.\n"
"                    <br/>\n"
"                    Dado que el Banco de México solo proporciona tipos de "
"cambio\n"
"                    basados en MXN, los tipos de cambio de otras monedas "
"extranjeras \n"
"                    recalculan y pueden diferir de los tipos reales."

