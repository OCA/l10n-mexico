<odoo>
    <record id="action_l10n_mx_cfdi_service_form" model="ir.ui.view">
        <field name="name">CFDI Service Settings</field>
        <field name="model">l10n_mx_cfdi.cfdi_service</field>
        <field name="arch" type="xml">
            <form string="PAC Settings">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="provider" />
                            <field name="supports_issue" />
                            <field name="supports_cancel" />
                            <field name="stamps_available" />
                            <field
                                name="company_ids"
                                groups="base.group_multi_company"
                                widget="many2many_tags"
                            />
                        </group>
                    </group>
                    <group string="Credentials" groups="base.group_system">
                        <field name="sandbox_mode" />
                        <field
                            name="user"
                            invisible="provider not in ('finkok', 'prodigia', 'comerciodigital', 'swsapien', 'mysuite', 'facturama')"
                        />
                        <field
                            name="password"
                            password="1"
                            invisible="provider not in ('finkok', 'prodigia', 'comerciodigital', 'swsapien', 'diverza', 'facturama')"
                        />
                        <field
                            name="pac_token"
                            password="1"
                            invisible="provider not in ('swsapien', 'diverza')"
                        />
                        <field name="pac_rfc" invisible="provider != 'diverza'" />
                        <field name="pac_client_id" invisible="provider != 'diverza'" />
                        <field name="pac_contrato" invisible="provider != 'prodigia'" />
                        <field name="pac_requestor" invisible="provider != 'mysuite'" />
                        <field name="pac_country" invisible="provider != 'mysuite'" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_mx_cfdi_settings" model="ir.actions.act_window">
        <field name="name">PAC Settings</field>
        <field name="res_model">l10n_mx_cfdi.cfdi_service</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="cfdi_settings_menu"
        name="PAC Settings"
        parent="l10n_mx_cfdi.cfdi_menu"
        groups="base.group_user"
        action="action_l10n_mx_cfdi_settings"
    />
</odoo>
