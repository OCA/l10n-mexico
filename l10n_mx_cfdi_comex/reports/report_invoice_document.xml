<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add l10n_mx_cfid_import_details to account.report_invoice_document lines -->
    <template id="report_invoice_document" inherit_id="account.report_invoice_document">
        <xpath expr="//td[@name='account_invoice_line_name']" position="replace">
            ---
            <span t-if="line.l10n_mx_cfid_import_details_required" t-field="line.l10n_mx_cfid_import_details"
                  t-options="{'widget': 'html'}">
                <p>
                    Fracción: 123456789
                    <br/>
                    Pedimento: 202100000000
                    <br/>
                    Aduana: 210 - Veracruz
                    <br/>
                </p>
            </span>

        </xpath>
    </template>
</odoo>
