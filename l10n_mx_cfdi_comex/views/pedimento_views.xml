<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_l10n_mx_cfdi_pedimento_list" model="ir.ui.view">
        <field name="name">l10n_mx_cfdi.pedimento.list</field>
        <field name="model">l10n_mx_cfdi.pedimento</field>
        <field name="arch" type="xml">
            <list string="Pedimentos">
                <field name="name" />
                <field name="number" />
                <field name="customs_id" />
                <field name="date" />
            </list>
        </field>
    </record>

    <record id="view_l10n_mx_cfdi_pedimentoento_form" model="ir.ui.view">
        <field name="name">l10n_mx_cfdi.pedimento.form</field>
        <field name="model">l10n_mx_cfdi.pedimento</field>
        <field name="arch" type="xml">
            <form string="Pedimento">
                <sheet>
                    <group>
                        <field name="name" readonly="1" />
                        <field name="number" />
                        <field name="customs_id" />
                        <field name="date" />
                    </group>

                    <notebook>
                        <page string="Lotes">
                            <field name="lot_ids" readonly="1">
                                <list>
                                    <field name="name" />
                                    <field name="product_id" />
                                    <field name="company_id" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_l10n_mx_cfdi_pedimento" model="ir.actions.act_window">
        <field name="name">Pedimentos</field>
        <field name="res_model">l10n_mx_cfdi.pedimento</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_l10n_mx_cfdi_pedimento"
        name="Pedimentos"
        parent="stock.menu_stock_inventory_control"
        action="action_l10n_mx_cfdi_pedimento"
        sequence="90"
    />
</odoo>
