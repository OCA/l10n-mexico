<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_l10n_mx_financial_report_wizard_form" model="ir.ui.view">
        <field name="name">l10n_mx.financial.report.wizard.form</field>
        <field name="model">l10n_mx.financial.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Mexico Financial Report">
                <group>
                    <field name="report_type" readonly="1" />
                    <field name="company_id" groups="base.group_multi_company" />
                    <field name="date_from" />
                    <field name="date_to" />
                </group>
                <footer>
                    <button
                        name="action_print_pdf"
                        type="object"
                        string="Print PDF"
                        class="btn-primary"
                    />
                    <button
                        name="action_export_diot_txt"
                        type="object"
                        string="Export DIOT (TXT)"
                        invisible="report_type != 'diot'"
                    />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
