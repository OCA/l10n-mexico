<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_mx_sat_purchase_invoice_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_mx_sat.purchase.invoice.wizard.form</field>
        <field name="model">l10n_mx_sat.purchase.invoice.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="not total_mismatch"
                >
                    The total of the selected CFDI differs from the orders total. Review the bill before posting it.
                </div>
                <div class="alert alert-info" role="alert" invisible="line_ids">
                    There is no CFDI of this vendor pending to bill in the SAT downloads.
                </div>
                <group>
                    <group>
                        <field
                            name="purchase_order_ids"
                            widget="many2many_tags"
                            readonly="1"
                        />
                        <field name="partner_id" />
                    </group>
                    <group>
                        <field name="amount_total" />
                        <field name="currency_id" invisible="1" />
                        <field name="company_id" invisible="1" />
                        <field
                            name="l10n_mx_sat_available_document_ids"
                            invisible="1"
                        />
                        <field name="l10n_mx_sat_document_id" invisible="1" />
                        <field name="total_mismatch" invisible="1" />
                    </group>
                </group>
                <field name="line_ids" invisible="not line_ids">
                    <list editable="bottom" create="0" delete="0">
                        <field name="selected" />
                        <field name="series" readonly="1" />
                        <field name="folio_number" readonly="1" />
                        <field name="issue_date" readonly="1" />
                        <field name="issuer_name" readonly="1" />
                        <field name="total" readonly="1" sum="Total" />
                        <field name="currency_code" readonly="1" />
                        <field name="sat_status" widget="badge" readonly="1" />
                        <field name="uuid" readonly="1" optional="hide" />
                        <field name="document_id" column_invisible="1" />
                    </list>
                </field>
                <footer>
                    <button
                        name="action_create_invoice"
                        string="Create Bill"
                        type="object"
                        class="btn-primary"
                        data-hotkey="q"
                        invisible="not line_ids"
                    />
                    <button
                        string="Cancel"
                        class="btn-secondary"
                        special="cancel"
                        data-hotkey="x"
                    />
                </footer>
            </form>
        </field>
    </record>
</odoo>
