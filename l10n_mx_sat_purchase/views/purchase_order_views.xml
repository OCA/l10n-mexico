<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="purchase_order_form" model="ir.ui.view">
        <field name="name">purchase.order.form.l10n_mx_sat</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <widget name="purchase_file_uploader" position="after">
                <field name="l10n_mx_sat_has_qty_to_bill" invisible="1" />
                <field name="l10n_mx_sat_has_bill_to_link" invisible="1" />
                <field name="l10n_mx_sat_has_refund_to_link" invisible="1" />
                <button
                    name="action_l10n_mx_sat_select_document"
                    type="object"
                    string="Bill from SAT"
                    invisible="state != 'purchase' or not (l10n_mx_sat_has_qty_to_bill or l10n_mx_sat_has_bill_to_link or l10n_mx_sat_has_refund_to_link)"
                />
            </widget>
        </field>
    </record>
</odoo>
