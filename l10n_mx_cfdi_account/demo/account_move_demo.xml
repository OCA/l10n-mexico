<odoo noupdate="1">
    <record id="cfdi_account_demo_invoice" model="account.move">
        <field name="move_type">out_invoice</field>
        <field name="partner_id" ref="cfdi_account_demo_customer" />
        <field name="receiver_id" ref="cfdi_account_demo_customer" />
        <field name="issuer_id" ref="cfdi_account_demo_issuer" />
        <field name="cfdi_required" eval="True" />
        <field name="cfdi_use_id" ref="l10n_mx_catalogs.c_uso_cfdi_G03" />
        <field name="payment_method_id" ref="l10n_mx_catalogs.c_metodo_pago_PUE" />
        <field name="payment_form_id" ref="l10n_mx_catalogs.c_forma_pago_03" />
        <field
            name="invoice_line_ids"
            eval="[(0, 0, {'product_id': ref('cfdi_account_demo_product'), 'quantity': 1, 'price_unit': 100.0})]"
        />
    </record>
</odoo>
