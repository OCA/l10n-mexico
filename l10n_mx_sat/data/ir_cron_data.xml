<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_sat_download" model="ir.cron">
        <field name="name">SAT: Daily bulk download</field>
        <field name="model_id" ref="model_l10n_mx_sat_download_request" />
        <field name="state">code</field>
        <field name="code">model._cron_process_requests()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- Do not run during module installation; FIEL is not loaded yet. -->
        <field
            name="nextcall"
            eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')"
        />
        <field name="active" eval="True" />
    </record>
</odoo>
