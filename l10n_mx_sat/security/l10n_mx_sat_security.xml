<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="res.groups.privilege" id="res_groups_privilege_sat">
        <field name="name">SAT</field>
        <field name="category_id" ref="base.module_category_hidden" />
    </record>
    <record id="group_sat_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_sat" />
    </record>
    <record id="group_sat_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_sat" />
        <field name="implied_ids" eval="[(4, ref('group_sat_user'))]" />
        <!-- Administrator role includes SAT manager, so the admin user keeps it. -->
        <field name="implied_by_ids" eval="[(4, ref('base.group_system'))]" />
        <field
            name="user_ids"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
    </record>
    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_sat_manager'))]" />
    </record>
</odoo>
