<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_mx_sat_fiel_credentials_wizard_view_form" model="ir.ui.view">
        <field name="name">l10n_mx_sat.fiel.credentials.wizard.form</field>
        <field name="model">l10n_mx_sat.fiel.credentials.wizard</field>
        <field name="arch" type="xml">
            <form string="Update FIEL credentials">
                <group>
                    <field name="company_id" />
                    <field name="fiel_cer" />
                    <field name="fiel_key" />
                    <field name="fiel_password" password="True" />
                </group>
                <footer>
                    <button
                        name="action_apply"
                        type="object"
                        string="Guardar"
                        class="btn-primary"
                    />
                    <button string="Cancelar" special="cancel" class="btn-secondary" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
